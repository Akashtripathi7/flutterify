# ---- Supabase ----
# From your Supabase project: Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# ---- Google Gemini (free) ----
# Free API key from https://aistudio.google.com/apikey  (no credit card needed).
# The key must start with "AIza". Create it in a NEW project.
GEMINI_API_KEY=AIza-your-gemini-key
# gemini-2.5-flash = best quality (free tier ~20 requests/day).
# gemini-2.0-flash = higher daily quota (~200/day) if your project has it enabled.
GEMINI_MODEL=gemini-2.5-flash

# Per-user daily token budget (input+output). Generation is blocked once exceeded.
DAILY_TOKEN_LIMIT=500000
