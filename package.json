{
  "name": "interview-prep",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:fresh": "kill -9 $(lsof -ti:3000) 2>/dev/null; next dev",
    "kill": "pkill -9 -f 'next dev' 2>/dev/null; pkill -9 -f 'next-server' 2>/dev/null; lsof -ti:3000,3001,3002,3003 | xargs kill -9 2>/dev/null; echo 'Killed all running dev servers.'",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "parse": "node scripts/parse-curriculum.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "lucide-react": "^1.22.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  }
}
